# Copia este archivo como .env y completa los valores
APP_ENV=production
APP_URL=https://tu-dominio.com/shopify-vitamin-assistant
APP_TIMEZONE=America/Mexico_City

# Seguridad
APP_ALLOWED_ORIGINS=https://tu-tienda.myshopify.com,https://www.tu-tienda.com
APP_API_KEY=define-una-clave-larga

# xAI / Grok
GROK_API_KEY=xai-xxxxx
GROK_MODEL=grok-3-latest
GROK_API_URL=https://api.x.ai/v1/chat/completions

# Shopify Admin API (Custom app)
SHOPIFY_STORE_DOMAIN=tu-tienda.myshopify.com
# Este token DEBE ser el "Admin API access token" (normalmente inicia con shpat_)
# No uses aquí Client ID ni Client Secret de la app.
SHOPIFY_ADMIN_TOKEN=shpat_xxxxx
SHOPIFY_API_VERSION=2026-01

# Ajustes del asistente
ASSISTANT_NAME=Asistente Salud Natural
ASSISTANT_LANGUAGE=es
CATALOG_CACHE_TTL=900
MAX_PRODUCTS_CONTEXT=20
MAX_COLLECTIONS_CONTEXT=10
